{"sha": "e45d389ccd90d0355bfc221633885b6b60b331b4", "filename": "Mathlib/NumberTheory/FunctionField.lean", "status": "modified", "additions": 14, "deletions": 3, "changes": 17, "blob_url": "https://github.com/leanprover-community/mathlib4/blob/9e25d78bddc80a691e3ddd82c1851ac46297861e/Mathlib%2FNumberTheory%2FFunctionField.lean", "raw_url": "https://github.com/leanprover-community/mathlib4/raw/9e25d78bddc80a691e3ddd82c1851ac46297861e/Mathlib%2FNumberTheory%2FFunctionField.lean", "contents_url": "https://api.github.com/repos/leanprover-community/mathlib4/contents/Mathlib%2FNumberTheory%2FFunctionField.lean?ref=9e25d78bddc80a691e3ddd82c1851ac46297861e", "patch": "@@ -6,9 +6,7 @@ Authors: Anne Baanen, Ashvni Narayanan\n module\n \n public import Mathlib.FieldTheory.RatFunc.Degree\n-public import Mathlib.RingTheory.DedekindDomain.IntegralClosure\n-public import Mathlib.RingTheory.IntegralClosure.IntegrallyClosed\n-public import Mathlib.Topology.Algebra.Valued.ValuedField\n+public import Mathlib.RingTheory.Valuation.Discrete.Basic\n \n /-!\n # Function fields\n@@ -219,6 +217,19 @@ theorem inftyValuation.polynomial {p : Fq[X]} (hp : p ≠ 0) :\n     inftyValuationDef Fq (algebraMap Fq[X] (RatFunc Fq) p) = exp (p.natDegree : ℤ) := by\n   rw [inftyValuationDef, if_neg (by simpa), RatFunc.intDegree_polynomial]\n \n+instance : Valuation.IsRankOneDiscrete (inftyValuation Fq) where\n+  exists_generator_lt_one' := by\n+    have h : IsUnit (exp (-1 : ℤ)) := normalize_eq_one.mp rfl\n+    refine ⟨h.unit, ?_, compareOfLessAndEq_eq_lt.mp rfl⟩\n+    ext x\n+    rw [Subgroup.mem_zpowers_iff, ← SetLike.mem_coe, ← Units.val_injective.mem_set_image,\n+      MonoidWithZeroHom.valueGroup_eq_range]\n+    simp only [Set.mem_diff, Set.mem_range, Set.mem_singleton_iff, Units.ne_zero,\n+      not_false_eq_true, and_true]\n+    exact ⟨fun ⟨k, hk⟩ ↦ ⟨RatFunc.X^(-k), by simp [← hk]⟩, fun ⟨y, hy⟩ ↦\n+      ⟨- (log ((FunctionField.inftyValuation Fq) y)),\n+        by ext; simp [← hy, exp_log (hy ▸ Units.ne_zero x)]⟩⟩\n+\n /-- The valued field `Fq(t)` with the valuation at infinity. -/\n def inftyValuedFqt : Valued (RatFunc Fq) ℤᵐ⁰ :=\n   Valued.mk' <| inftyValuation Fq"}], "timeline": [{"sha": "9e25d78bddc80a691e3ddd82c1851ac46297861e", "node_id": "C_kwDOFcwZ1doAKDllMjVkNzhiZGRjODBhNjkxZTNkZGQ4MmMxODUxYWM0NjI5Nzg2MWU", "url": "https://api.github.com/repos/leanprover-community/mathlib4/git/commits/9e25d78bddc80a691e3ddd82c1851ac46297861e", "html_url": "https://github.com/leanprover-community/mathlib4/commit/9e25d78bddc80a691e3ddd82c1851ac46297861e", "author": {"name": "Xavier Genereux", "email": "xaviergenereux@hotmail.com", "date": "2025-12-18T18:55:13Z"}, "committer": {"name": "Xavier Genereux", "email": "xaviergenereux@hotmail.com", "date": "2025-12-18T18:55:13Z"}, "tree": {"sha": "bce9493f3c90fb2340ee3f72ba95af1fb0d19577", "url": "https://api.github.com/repos/leanprover-community/mathlib4/git/trees/bce9493f3c90fb2340ee3f72ba95af1fb0d19577"}, "message": "feat: IsRankOneDiscrete (inftyValuation Fq)", "parents": [{"sha": "8c38971b569e23002efb3f60043048cc516407a2", "url": "https://api.github.com/repos/leanprover-community/mathlib4/git/commits/8c38971b569e23002efb3f60043048cc516407a2", "html_url": "https://github.com/leanprover-community/mathlib4/commit/8c38971b569e23002efb3f60043048cc516407a2"}], "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}, "event": "committed"}, {"id": 21651725752, "node_id": "LE_lADOFcwZ1c7fL0sszwAAAAUKix24", "url": "https://api.github.com/repos/leanprover-community/mathlib4/issues/events/21651725752", "actor": {"login": "github-actions[bot]", "id": 41898282, "node_id": "MDM6Qm90NDE4OTgyODI=", "avatar_url": "https://avatars.githubusercontent.com/in/15368?v=4", "gravatar_id": "", "url": "https://api.github.com/users/github-actions%5Bbot%5D", "html_url": "https://github.com/apps/github-actions", "followers_url": "https://api.github.com/users/github-actions%5Bbot%5D/followers", "