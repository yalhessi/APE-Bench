#!/usr/bin/env bash
# ptool <tool>|list|describe ['<json arguments>'] -- one call to the pipeline's own review tools for
# this PR, as an arm makes it (`cli tool`). The wrapper, not the reviewer, logs every call.
set -o pipefail
PR=30641; OUT=/research/projects/proofedit/ya475/APE-Bench/.claude/worktrees/conventions-nature/results/pr_review_v5/probes/model-gap-val-small12/pr30641/E1; WORK=/tmp/claude-1905243447/-research-projects-proofedit-ya475-APE-Bench/81db077f-602b-4836-bb76-d647fe1c2e3a/scratchpad/claude_stage_E/work/pr30641/E1; RAW=/tmp/claude-1905243447/-research-projects-proofedit-ya475-APE-Bench/81db077f-602b-4836-bb76-d647fe1c2e3a/scratchpad/claude_stage_E/raw/pr30641/E1
cd /research/projects/proofedit/ya475/APE-Bench/.claude/worktrees/conventions-nature && export PYTHONPATH="$PWD/src" PATH="$HOME/.elan/bin:$PATH"
stamp=$(date +%s%N)-$$
mkdir -p "$RAW"
ape/bin/python -m src.mathlib_review.review.cli tool "$1" \
  --episodes inputs/pr_review_v4/releases/val-2025-06-2026-03-v1/input/episodes.jsonl --pr "$PR" \
  --workdir "$WORK" --run-config configs/pr_review_v5_val_2025_06_2026_03_v1_small12.yaml \
  --arguments "${2:-}" > "$RAW/$stamp.out" 2> "$RAW/$stamp.err"
status=$?
ape/bin/python -m src.mathlib_review.review.cli probe log-call "$OUT/calls.jsonl" "$stamp" "$1" "${2:-}" "$RAW/$stamp.out" "$status"
cat "$RAW/$stamp.out"
[ $status -eq 0 ] || tail -5 "$RAW/$stamp.err" >&2
exit $status
