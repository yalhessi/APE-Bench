#!/usr/bin/env bash
# ptool <tool>|list|describe ['<json arguments>'] -- one call to the pipeline's own review tools for
# this PR, as an arm makes it (`cli tool`). The wrapper, not the reviewer, logs every call.
set -o pipefail
PR=34935; OUT=/research/projects/proofedit/ya475/APE-Bench/.claude/worktrees/pipeline-overfit-review/results/pr_review_v5/probes/model-gap-val-small12/pr34935/X1; WORK=/research/projects/proofedit/ya475/APE-Bench/.ape/probe_scratch/val_small12/work/pr34935/X1; RAW=/research/projects/proofedit/ya475/APE-Bench/.ape/probe_scratch/val_small12/raw/pr34935/X1
cd /research/projects/proofedit/ya475/APE-Bench/.claude/worktrees/pipeline-overfit-review && export PYTHONPATH="$PWD/src" PATH="$HOME/.elan/bin:$PATH"
stamp=$(date +%s%N)-$$
mkdir -p "$RAW"
ape/bin/python -m src.mathlib_review.review.cli tool "$1" \
  --episodes inputs/pr_review_v4/releases/val-2025-06-2026-03-v1/input/episodes.jsonl --pr "$PR" \
  --workdir "$WORK" --run-config configs/pr_review_v5_val_2025_06_2026_03_v1_small12.yaml \
  --arguments "${2:-}" > "$RAW/$stamp.out" 2> "$RAW/$stamp.err"
status=$?
ape/bin/python -m src.mathlib_review.review.cli probe log-call "$OUT/calls.jsonl" "$stamp" "$1" "${2:-}" "$RAW/$stamp.out" "$status"
cat "$RAW/$stamp.out"
[ $status -eq 0 ] || tail -5 "$RAW/$stamp.err" >&2
exit $status
