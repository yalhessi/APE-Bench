{"stamp": "1790695164073056989-4141646", "tool": "lean_verify_edit", "exit": 0, "arguments": {"path": "Mathlib/Geometry/Euclidean/Angle/Sphere.lean", "line_start": 129, "line_end": 135, "replacement": "/-- The central angle subtended by a diameter of a sphere of nonzero radius is `π`. -/\ntheorem IsDiameter.angle_center_eq_pi {s : Sphere P} {p₁ p₂ : P} (h : s.IsDiameter p₁ p₂)\n    (hr : s.radius ≠ 0) : ∠ p₁ s.center p₂ = π :=\n  (h.sbtw hr).angle₁₂₃_eq_pi\n\n/-- On a sphere of nonzero radius, the central angle `∠ p₁ s.center p₂` equals `π` iff\n`p₁` and `p₂` are diametrically opposite. -/\ntheorem angle_center_eq_pi_iff_isDiameter {s : Sphere P} {p₁ p₂ : P}\n    (hp₁ : p₁ ∈ s) (hp₂ : p₂ ∈ s) (hr : s.radius ≠ 0) :\n    ∠ p₁ s.center p₂ = π ↔ s.IsDiameter p₁ p₂ :=\n  ⟨fun h ↦ isDiameter_iff_mem_and_mem_and_wbtw.2 ⟨hp₁, hp₂, (angle_eq_pi_iff_sbtw.1 h).wbtw⟩,\n    fun h ↦ h.angle_center_eq_pi hr⟩"}, "result": {"mode": "verified_edit", "success": true, "errors_introduced": 0, "errors_already": 0, "environment_reviewed": false}}
{"stamp": "1790695173805151562-4141994", "tool": "lean_verify_edit", "exit": 0, "arguments": {"path": "Mathlib/Geometry/Euclidean/Angle/Sphere.lean", "declaration_name": "EuclideanGeometry.Sphere.angle_center_eq_zero_iff_eq", "new_declaration": "theorem angle_center_eq_zero_iff_eq {s : Sphere P} {p₁ p₂ : P}\n    (hp₁ : p₁ ∈ s) (hp₂ : p₂ ∈ s) (hr : s.radius ≠ 0) :\n    ∠ p₁ s.center p₂ = 0 ↔ p₁ = p₂ := by\n  constructor\n  · intro h\n    refine vsub_left_cancel (eq_of_angle_eq_zero_of_norm_eq h ?_)\n    rw [norm_vsub_center_eq_radius hp₁, norm_vsub_center_eq_radius hp₂]\n  · rintro rfl\n    exact angle_self_of_ne fun h => hr (center_mem_iff.mp (h ▸ hp₁))"}, "result": {"mode": "verified_edit", "success": true, "errors_introduced": 0, "errors_already": 0, "environment_reviewed": false}}
