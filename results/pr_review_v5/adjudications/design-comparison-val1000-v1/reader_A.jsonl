{"cid": "v0053", "group": "A", "principle_stated": "implicit", "principle_source": "library_practice", "principle": "Build a definition from the constructor that takes the data already at hand rather than through an intermediate isomorphism, and do not keep both."}
{"cid": "v0297", "group": "A", "principle_stated": "implicit", "principle_source": "library_practice", "principle": "A relation that only serves as the `≤` instance is inlined into the instance, not given its own structure."}
{"cid": "v0384", "group": "A", "principle_stated": "implicit", "principle_source": "library_practice", "principle": "Statements should elaborate without explicit `@` application."}
{"cid": "v0540", "group": "A", "principle_stated": "explicit", "principle_source": "library_practice", "principle": "A constructor with many fields takes a structure of its data, so users get a skeleton from code actions."}
{"cid": "v0587", "group": "A", "principle_stated": "implicit", "principle_source": "tacit", "principle": "A Decidable instance should evaluate efficiently, not re-evaluate the predicate quadratically."}
{"cid": "v0622", "group": "A", "principle_stated": "implicit", "principle_source": "library_practice", "principle": "State results in simp-normal form (`1`, not `exp 0`)."}
{"cid": "v0802", "group": "A", "principle_stated": "explicit", "principle_source": "library_practice", "principle": "Prefer a characterisation of `range (map f g)` over a specialised monotonicity consequence."}
{"cid": "v0830", "group": "A", "principle_stated": "explicit", "principle_source": "library_practice", "principle": "Long proofs are split, with the interesting estimates as their own lemmas."}
{"cid": "v0891", "group": "A", "principle_stated": "implicit", "principle_source": "library_practice", "principle": "State a result as an iff when the converse holds."}
{"cid": "v0919", "group": "A", "principle_stated": "implicit", "principle_source": "library_practice", "principle": "Factor a reusable step into a general dot-notation lemma."}
{"cid": "v1112", "group": "A", "principle_stated": "explicit", "principle_source": "mathematical", "principle": "Separate a construction from its application: define the general operation on generators and derive the special case."}
{"cid": "v1149", "group": "A", "principle_stated": "implicit", "principle_source": "mathematical", "principle": "Prefer a direct computation over a bounded search when one exists."}
{"cid": "v1173", "group": "A", "principle_stated": "explicit", "principle_source": "library_practice", "principle": "Provide the basic API (`const`, `congr`) from which specialised lemmas follow, and reserve the canonical names for the basic ones."}
{"cid": "v1174", "group": "A", "principle_stated": "explicit", "principle_source": "library_practice", "principle": "Develop general API rather than a specialised lemma."}
{"cid": "v1191", "group": "A", "principle_stated": "implicit", "principle_source": "library_practice", "principle": "State results as characterisations independent of a particular instance construction."}
{"cid": "v1267", "group": "A", "principle_stated": "implicit", "principle_source": "library_practice", "principle": "Do not quantify over a universe of index types inside a class; then extensionality is a theorem, not a field."}
{"cid": "v1456", "group": "A", "principle_stated": "explicit", "principle_source": "mathematical", "principle": "Formalise the recurring mathematical concept (adjacent sequences) rather than the ad hoc instance."}
{"cid": "v1457", "group": "A", "principle_stated": "explicit", "principle_source": "library_practice", "principle": "Define the object you will reason about (the iterated sequence) directly, not only one step."}
{"cid": "v1459", "group": "A", "principle_stated": "implicit", "principle_source": "library_practice", "principle": "A definition made with `choose` comes with lemmas exposing its `choose_spec` properties."}
{"cid": "v1497", "group": "A", "principle_stated": "implicit", "principle_source": "mathematical", "principle": "State the strongest natural consequence (an isomorphism) rather than partial facts."}
{"cid": "v1549", "group": "A", "principle_stated": "implicit", "principle_source": "library_practice", "principle": "State lemmas with expanded functions rather than compositions."}
{"cid": "v1592", "group": "A", "principle_stated": "explicit", "principle_source": "library_practice", "principle": "Introduce a definition at its most general level, with API, or leave a TODO."}
{"cid": "v1645", "group": "A", "principle_stated": "implicit", "principle_source": "library_practice", "principle": "Provide the universe-polymorphic `OfSize` form of a preservation instance."}
{"cid": "v1907", "group": "A", "principle_stated": "explicit", "principle_source": "library_practice", "principle": "Express a property of objects as an `ObjectProperty` and state conditions with `IsIso`, not bespoke structures."}
{"cid": "v1992", "group": "A", "principle_stated": "implicit", "principle_source": "library_practice", "principle": "Extract an inline construction into an auxiliary definition."}
{"cid": "v1998", "group": "A", "principle_stated": "implicit", "principle_source": "library_practice", "principle": "Define the general functorial object (iteration as a functor) instead of ad hoc recursive definitions."}
{"cid": "v2037", "group": "A", "principle_stated": "explicit", "principle_source": "library_practice", "principle": "When a structure extends another, define the extended one directly rather than in two stages."}
{"cid": "v2066", "group": "A", "principle_stated": "implicit", "principle_source": "library_practice", "principle": "A fact used inside a proof is its own lemma."}
{"cid": "v2112", "group": "A", "principle_stated": "implicit", "principle_source": "library_practice", "principle": "Give a default instance by its canonical construction, not through a general helper."}
{"cid": "v2117", "group": "A", "principle_stated": "implicit", "principle_source": "library_practice", "principle": "State a result as an iff when the converse holds."}
{"cid": "v2263", "group": "A", "principle_stated": "explicit", "principle_source": "library_practice", "principle": "Generalise the core of a proof to a lemma about the underlying general construction."}
